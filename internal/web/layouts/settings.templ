package layouts

import "example.com/segments/internal/web/seg"

templ SettingsSegment(child templ.Component) {
	<div>
		@SettingsTabs()
		<div id="outlet-settings">
			@child
		</div>
	</div>
}

templ SettingsTabs() {
	<nav id={ settingsTabsID(seg.InModal(ctx)) } class="flex items-center gap-1 border-b border-border text-sm">
		@SettingsTab("/dashboard/settings", "General")
		@SettingsTab("/dashboard/settings/notifications", "Notifications")
		@SettingsTab("/dashboard/settings/billing", "Billing")
	</nav>
}

// SettingsTabsOOB refreshes the tab bar in place after a leaf-only swap.
templ SettingsTabsOOB() {
	<nav id={ settingsTabsID(seg.InModal(ctx)) } hx-swap-oob="outerHTML" class="flex items-center gap-1 border-b border-border text-sm">
		@SettingsTab("/dashboard/settings", "General")
		@SettingsTab("/dashboard/settings/notifications", "Notifications")
		@SettingsTab("/dashboard/settings/billing", "Billing")
	</nav>
}

// settingsTabsID keeps the modal and page tab bars distinct so their OOB
// swaps never collide (both can be mounted at once).
func settingsTabsID(inModal bool) string {
	if inModal {
		return "settings-tabs-modal"
	}
	return "settings-tabs"
}

templ SettingsTab(href, label string) {
	<a
		href={ href }
		hx-get={ href }
		hx-push-url="true"
		if seg.InModal(ctx) {
			hx-target="#modal-root [data-page-modal] #outlet-settings"
			hx-headers={ seg.ModalKeepHeader(seg.ModalOwner(ctx)) }
		}
		class={ "px-3 py-2 transition-colors", settingsTabClass(seg.Path(ctx), href) }
	>{ label }</a>
}

func settingsTabClass(current, href string) string {
	if current == href {
		return "text-foreground border-b-2 border-foreground"
	}
	return "text-muted-foreground hover:bg-muted hover:text-foreground"
}
