package layouts

import (
	"strings"

	"example.com/segments/internal/web/seg"
)

// SettingsSegment wraps settings pages with a tab bar. Active tab comes from
// seg.Path; inside a modal the links carry the modal target + X-Modal:keep.
templ SettingsSegment(child templ.Component) {
	<div>
		@SettingsTabs()
		<div id="outlet-settings">
			@child
		</div>
	</div>
}

templ SettingsTabs() {
	<nav id="settings-tabs" class="flex items-center gap-1 border-b border-border text-sm">
		@SettingsTab("/dashboard/settings", "General")
		@SettingsTab("/dashboard/settings/billing", "Billing")
	</nav>
}

// SettingsTabsOOB refreshes the tab bar in place after a leaf-only swap.
templ SettingsTabsOOB() {
	<nav id="settings-tabs" hx-swap-oob="outerHTML" class="flex items-center gap-1 border-b border-border text-sm">
		@SettingsTab("/dashboard/settings", "General")
		@SettingsTab("/dashboard/settings/billing", "Billing")
	</nav>
}

templ SettingsTab(href, label string) {
	<a
		href={ href }
		hx-get={ href }
		hx-push-url="true"
		if seg.InModal(ctx) {
			hx-target="#modal-root [data-page-modal] #outlet-settings"
			hx-headers={ seg.ModalKeepHeader(seg.ModalOwner(ctx)) }
		}
		class={ "px-3 py-2 transition-colors", settingsTabClass(seg.Path(ctx), href) }
	>{ label }</a>
}

// settingsTabClass highlights the tab whose URL matches (or is a parent of)
// the current path.
func settingsTabClass(current, href string) string {
	if current == href || strings.HasPrefix(current, href+"/") {
		return "text-foreground border-b-2 border-foreground"
	}
	return "text-muted-foreground hover:bg-muted hover:text-foreground"
}
