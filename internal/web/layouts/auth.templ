package layouts

templ AuthSegment(child templ.Component) {
	<div class="relative grid min-h-dvh place-items-center overflow-hidden px-4">
		<div class="pointer-events-none absolute inset-0 auth-bg" aria-hidden="true"></div>
		<main id="outlet-auth" class="relative w-full max-w-sm">
			@child
		</main>
	</div>
}
