package pages

templ About() {
	<section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">About</h1>
			<p class="mt-4 text-muted-foreground">
