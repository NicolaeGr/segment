package pages

templ About() {
	<section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-3xl font-bold tracking-tight md:text-4xl">The whole trick is a prefix diff.</h1>
			<p class="mt-4 text-muted-foreground">
				Your browser reports which segments it has mounted in an
				<code class="rounded bg-muted px-1.5 py-0.5 text-sm">X-Mounted-Segments</code>
				header. The server diffs that against the stack the route lives under and
				renders only what's missing.
			</p>
			<div class="mt-10 space-y-8">
				<div>
					<h2 class="text-lg font-semibold">1 · Segments, not layouts</h2>
					<p class="mt-2 text-muted-foreground">
						A layout is a <em>segment</em>: a stable ID, an outlet for its child,
						and an optional data loader that runs exactly when the segment mounts.
					</p>
				</div>
				<div>
					<h2 class="text-lg font-semibold">2 · The client reports its stack</h2>
					<p class="mt-2 text-muted-foreground">
						Two tiny hooks in <code class="rounded bg-muted px-1.5 py-0.5 text-sm">app.js</code> —
						one attaches the mounted stack to every request, one updates it from the
						server's <code class="rounded bg-muted px-1.5 py-0.5 text-sm">segments</code> trigger.
						CSS can react via <code class="rounded bg-muted px-1.5 py-0.5 text-sm">body[data-stack]</code>.
					</p>
				</div>
				<div>
					<h2 class="text-lg font-semibold">3 · Data binds to mount, not navigation</h2>
					<p class="mt-2 text-muted-foreground">
						Navigate between ten dashboard pages and the user profile is fetched
						once. Stale chrome like a notification badge updates via
						out-of-band swaps, not refetches.
					</p>
				</div>
				<div>
					<h2 class="text-lg font-semibold">4 · Modals are just another outlet</h2>
					<p class="mt-2 text-muted-foreground">
						The same URL serves both the modal and the expanded page — only the
						<code class="rounded bg-muted px-1.5 py-0.5 text-sm">X-Modal</code> header
						differs. Reload, back button and expand all work, because the URL
						alone always determines the full render.
					</p>
				</div>
			</div>
			<div class="mt-12 rounded-lg border border-border bg-muted/40 p-5">
				<p class="text-sm font-medium">Try it</p>
				<p class="mt-1 text-sm text-muted-foreground">
					Open the app, click through the dashboard, and open Settings as a modal.
					Reload the modal URL, then expand it to a full page — same URL, no
					special-case code.
				</p>
				<a
					href="/login"
					hx-get="/login"
					hx-push-url="true"
					class="btn btn-secondary mt-4"
				>Open the app</a>
			</div>
		</div>
	</section>
}
