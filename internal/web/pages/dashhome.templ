package pages

import (
	"example.com/segments/internal/web/domain"
	"example.com/segments/internal/web/seg"
)

// DashHome is the dashboard overview; seg.Data(ctx, "dashboard") is the user
// loaded once when the dashboard segment mounted.
templ DashHome() {
	<div class="space-y-8">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="text-2xl font-bold tracking-tight">Overview</h1>
				<p class="mt-1 text-sm text-muted-foreground">Welcome back, { userName(seg.Data(ctx, "dashboard")) }. This page re-renders every visit; the user data above was fetched once.</p>
			</div>
			<button
				type="button"
				class="btn btn-outline"
				hx-post="/notifications/read"
				hx-swap="none"
			>Mark all read</button>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			@Card("Revenue", "$12,480", "+8.2%", "vs last month")
			@Card("Active users", "1,024", "+2.1%", "vs last month")
			@Card("Conversion", "4.3%", "-0.4%", "vs last month")
		</div>
		<div class="rounded-lg border border-border bg-background p-5">
			<div class="flex items-center justify-between">
				<h2 class="text-sm font-semibold">Recent activity</h2>
				<span class="text-xs text-muted-foreground">updated in this swap</span>
			</div>
			<ul class="mt-4 divide-y divide-border text-sm">
				@Activity("New signup from acme.org", "2m ago")
				@Activity("Invoice #2041 paid", "1h ago")
				@Activity("Deployment finished", "3h ago")
			</ul>
		</div>
		<div class="rounded-lg border border-border bg-muted/40 p-5 text-sm text-muted-foreground">
			<p>
				<strong class="font-medium text-foreground">Try it:</strong> click <em>Settings</em> in the
				sidebar — it opens as a modal. Reload that URL and you get the full
				page. Navigate between the <em>General</em> and <em>Billing</em> tabs inside the
				modal, then hit the expand button (⤢) to open the current tab as a full
				page. Back button works too.
			</p>
		</div>
	</div>
}

templ Card(label, value, delta, hint string) {
	<div class="rounded-lg border border-border bg-background p-5">
		<p class="text-sm text-muted-foreground">{ label }</p>
		<p class="mt-2 text-2xl font-semibold tracking-tight">{ value }</p>
		<p class="mt-1 text-xs">
			<span class="font-medium text-foreground">{ delta }</span>
			<span class="text-muted-foreground">{ hint }</span>
		</p>
	</div>
}

templ Activity(title, time string) {
	<li class="flex items-center justify-between py-3">
		<span>{ title }</span>
		<span class="text-xs text-muted-foreground">{ time }</span>
	</li>
}

// userName mirrors the layouts helper so pages can render the dashboard
// segment's loaded user without reaching into another package.
func userName(v any) string {
	if usr, ok := v.(*domain.User); ok && usr != nil {
		return usr.Name
	}
	return "Guest"
}
