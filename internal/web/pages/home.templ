package pages

templ Home() {
	<section class="mx-auto max-w-6xl px-4 py-20 md:py-28">
		<div class="mx-auto max-w-2xl text-center">
			<span class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground">Server-driven segment stack</span>
			<h1 class="mt-6 text-4xl font-bold tracking-tight md:text-6xl">Layouts that know<br/>what's already on screen.</h1>
			<p class="mt-6 text-lg text-muted-foreground">
				One middleware, one renderer, one modal wrapper. Every layout is a
				segment with an outlet — htmx only ever receives the parts of the tree
				that are missing.
			</p>
			<div class="mt-10 flex items-center justify-center gap-3">
				<a
					href="/login"
					hx-get="/login"
					hx-push-url="true"
					class="btn btn-secondary"
				>Open the app</a>
				<a
					href="/about"
					hx-get="/about"
					hx-push-url="true"
					class="btn btn-outline"
				>How it works</a>
			</div>
		</div>
	</section>
}
