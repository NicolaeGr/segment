package pages

import "net/http"

templ Billing() {
	<div class="mx-auto max-w-2xl space-y-8">
		<div>
			<h1 class="text-2xl font-bold tracking-tight">Billing</h1>
			<p class="mt-1 text-sm text-muted-foreground">Manage your plan and invoices.</p>
		</div>
		<div class="rounded-lg border border-border bg-background p-5">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium">Current plan</p>
					<p class="text-sm text-muted-foreground">—</p>
				</div>
				<span class="rounded-full border border-border px-3 py-1 text-xs font-medium">—</span>
			</div>
			<div class="mt-4 border-t border-border pt-4">
				<button
					type="button"
					class="btn btn-outline"
					hx-post="/billing/export"
					hx-swap="none"
				>Export</button>
			</div>
		</div>
		<div class="rounded-lg border border-border bg-background">
			<div class="flex items-center justify-between border-b border-border px-5 py-3">
				<p class="text-sm font-semibold">Invoices</p>
			</div>
			<div class="divide-y divide-border text-sm">
				<p class="px-5 py-4 text-muted-foreground">No invoices yet.</p>
			</div>
		</div>
	</div>
}

func billingLeaf(r *http.Request) (string, templ.Component) {
	return "Billing", Billing()
}

var BillingLeaf = billingLeaf
